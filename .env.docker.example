# Responsabilidad: documenta las variables requeridas por Docker Compose sin almacenar secretos reales.
# Relación: configura puertos, base de datos y credenciales utilizadas por SQL Server, API y frontend.

MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
MSSQL_DATABASE=DotNetTestMundial_Docker

SQLSERVER_HOST_PORT=14330
API_HOST_PORT=5164
FRONTEND_HOST_PORT=3000